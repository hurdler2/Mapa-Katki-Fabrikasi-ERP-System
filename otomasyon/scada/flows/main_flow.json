    {
        "id": "parse_registers",
        "type": "function",
        "z": "tab_main",
        "name": "Parse Modbus registers",
        "func": "// Parse PLC data into JSON\nconst regs = msg.payload;\n\n// Register mapping\nfunction readReal(offset) {\n    const buf = Buffer.alloc(4);\n    buf.writeUInt16BE(regs[offset], 0);\n    buf.writeUInt16BE(regs[offset+1], 2);\n    return buf.readFloatBE(0);\n}\n\nconst data = {\n    timestamp: new Date().toISOString(),\n    batch_state: regs[0],\n    recipe_version: regs[1],\n    alarm_bits: regs[2],\n    r01_kg: readReal(9),\n    r01_temp: readReal(11),\n    r01_ph: readReal(13),\n    r01_cl: readReal(15),\n    t01_kg: readReal(17),\n    t02_kg: readReal(19),\n    t03_kg: readReal(21),\n    t04_kg: readReal(23),\n    t05_kg: readReal(25),\n    t06_water_kg: readReal(27),\n    target_kg: readReal(39)\n};\n\n// State text (matches PLC state list)\nconst states = {\n    0: 'IDLE',\n    1: 'RECIPE_LOAD',\n    2: 'PRECHECK',\n    3: 'WATER_FILL',\n    4: 'DOSE_RM1',\n    5: 'DOSE_RM2',\n    6: 'DOSE_RM3',\n    7: 'DOSE_RM4',\n    8: 'DOSE_RM5',\n    9: 'MIXING',\n    10: 'QC_SAMPLE',\n    11: 'DISCHARGE',\n    12: 'CIP_CLEAN',\n    99: 'ABORTED'\n};\ndata.state_text = states[data.batch_state] || 'UNKNOWN';\n\nmsg.payload = data;\nflow.set('current_data', data);\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 380,
        "y": 100,
        "wires": [
            [
                "gauge_weight",
                "gauge_ph",
                "gauge_temp",
                "text_state",
                "chart_trend",
                "history_db",
                "check_batch_complete"
            ]
        ]
    },
