    {
        "id": "history_db",
        "type": "function",
        "z": "tab_main",
        "name": "Downsample 5s → DB",
        "func": "// Downsample raw 100ms → 5s for historian\nconst now = Date.now();\nconst last = flow.get('last_hist_write') || 0;\nif (now - last < 5000) {\n    return null;\n}\nflow.set('last_hist_write', now);\n\nconst d = msg.payload;\nmsg.payload = {\n    ts: d.timestamp,\n    r01_kg: d.r01_kg,\n    r01_ph: d.r01_ph,\n    r01_temp: d.r01_temp,\n    r01_cl: d.r01_cl,\n    batch_state: d.batch_state\n};\nreturn msg;",
        "outputs": 1,
        "x": 380,
        "y": 200,
        "wires": [
            [
                "postgres_insert"
            ]
        ]
    },
    {
        "id": "postgres_insert",
        "type": "postgresql",
        "z": "tab_main",
        "name": "Insert historian",
        "query": "INSERT INTO scada_historian (ts, r01_kg, r01_ph, r01_temp, r01_cl, batch_state) VALUES ($1, $2, $3, $4, $5, $6)",
        "postgreSQLConfig": "pg_admix",
        "split": false,
        "rowsPerMsg": 1,
        "outputs": 1,
        "x": 630,
        "y": 200,
        "wires": [
            []
        ]
