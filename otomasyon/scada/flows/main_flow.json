        "topic": "live",
        "showStatusActivities": false,
        "logIOActivities": false,
        "showErrors": false,
        "unitid": "",
        "dataType": "HoldingRegister",
        "adr": "40001",
        "quantity": "40",
        "rate": "100",
        "rateUnit": "ms",
        "delayOnStart": true,
        "startDelayTime": "2",
        "server": "modbus_server_plc",
