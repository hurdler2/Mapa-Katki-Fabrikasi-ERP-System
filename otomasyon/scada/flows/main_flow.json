        "id": "pg_admix",
        "type": "postgreSQLConfig",
        "name": "ADMIX-ERP DB",
        "host": "127.0.0.1",
        "hostFieldType": "str",
        "port": "5432",
        "portFieldType": "num",
        "database": "admix_erp",
        "databaseFieldType": "str",
