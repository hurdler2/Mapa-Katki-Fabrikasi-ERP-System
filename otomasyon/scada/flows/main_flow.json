        "maxFieldType": "num",
        "idle": 1000,
        "idleFieldType": "num",
        "connectionTimeout": 10000,
        "connectionTimeoutType": "num",
        "user": "admix",
        "userFieldType": "str",
        "password": "REPLACE_ME",
        "passwordFieldType": "str"
    },
    {
        "id": "check_batch_complete",
        "type": "function",
        "z": "tab_main",
        "name": "On batch complete",
        "func": "// Watch for CIP_CLEAN transition — batch complete\nconst d = msg.payload;\nconst prev = flow.get('prev_state') || 0;\nflow.set('prev_state', d.batch_state);\n\n// CIP_CLEAN reached and prev was DISCHARGE → batch complete\nif (d.batch_state === 12 && prev === 11) {\n    // Fetch batch payload from flow context (accumulated during dosing)\n    const batch = flow.get('current_batch') || {};\n    batch.completed_at = d.timestamp;\n    batch.actual_kg = d.r01_kg;\n    msg.payload = batch;\n    return msg;\n}\nreturn null;",
        "outputs": 1,
        "x": 380,
        "y": 340,
        "wires": [
            [
                "post_to_admix"
            ]
        ]
    },
